<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kai_whatsapp_ai_config_company" model="ir.rule">
        <field name="name">WhatsApp AI provider: company</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="kai_whatsapp_ai_faq_company" model="ir.rule">
        <field name="name">WhatsApp AI FAQ: company</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_faq"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="kai_whatsapp_ai_catalog_company" model="ir.rule">
        <field name="name">WhatsApp AI catalog: company</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_catalog"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="kai_whatsapp_ai_suggestion_company" model="ir.rule">
        <field name="name">WhatsApp AI suggestion: company</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_suggestion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="kai_whatsapp_ai_suggestion_line_company" model="ir.rule">
        <field name="name">WhatsApp AI suggestion line: company</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_suggestion_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="kai_whatsapp_ai_config_user" model="ir.rule">
        <field name="name">WhatsApp AI provider: allowed account or company fallback</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_config"/>
        <field name="domain_force">['|', ('account_id', '=', False), ('account_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('group_user'))]"/>
    </record>
    <record id="kai_whatsapp_ai_config_manager" model="ir.rule">
        <field name="name">WhatsApp AI provider: managers</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_manager'))]"/>
    </record>
    <record id="kai_whatsapp_ai_faq_user" model="ir.rule">
        <field name="name">WhatsApp AI FAQ: allowed account or company fallback</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_faq"/>
        <field name="domain_force">['|', ('config_id.account_id', '=', False), ('config_id.account_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('group_user'))]"/>
    </record>
    <record id="kai_whatsapp_ai_faq_manager" model="ir.rule">
        <field name="name">WhatsApp AI FAQ: managers</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_faq"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_manager'))]"/>
    </record>
    <record id="kai_whatsapp_ai_catalog_user" model="ir.rule">
        <field name="name">WhatsApp AI catalog: allowed account or company fallback</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_catalog"/>
        <field name="domain_force">['|', ('config_id.account_id', '=', False), ('config_id.account_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('group_user'))]"/>
    </record>
    <record id="kai_whatsapp_ai_catalog_manager" model="ir.rule">
        <field name="name">WhatsApp AI catalog: managers</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_catalog"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_manager'))]"/>
    </record>
    <record id="kai_whatsapp_ai_suggestion_user" model="ir.rule">
        <field name="name">WhatsApp AI suggestion: allowed users who belong to the conversation</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_suggestion"/>
        <field name="domain_force">['&amp;', ('account_id.user_ids', 'in', [user.id]), '|', ('channel_id', '=', False), ('channel_id.channel_member_ids.partner_id', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[Command.link(ref('group_user'))]"/>
    </record>
    <record id="kai_whatsapp_ai_suggestion_manager" model="ir.rule">
        <field name="name">WhatsApp AI suggestion: managers</field>
        <field name="model_id" ref="model_kai_whatsapp_ai_suggestion"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_manager'))]"/>
    </record>
</odoo>
