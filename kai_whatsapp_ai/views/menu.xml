              parent="om_whatsapp_base.om_whatsapp_menu_config"
              action="kai_whatsapp_ai_provider_rate_action" sequence="23"
              groups="group_manager"/>
    <menuitem id="menu_kai_whatsapp_ai_billable_rates" name="Client rates"
              parent="om_whatsapp_base.om_whatsapp_menu_config"
              action="kai_whatsapp_ai_billable_rate_action" sequence="24"
              groups="group_manager"/>
    <menuitem id="menu_kai_whatsapp_ai_faq" name="FAQ"
              parent="om_whatsapp_base.om_whatsapp_menu_root"
              action="kai_whatsapp_ai_faq_action" sequence="18"
              groups="group_trainer"/>

    <!-- Trainers open the WhatsApp app for the assistant screens only.
         Messages and templates stay with the WhatsApp user group. -->
    <record id="om_whatsapp_base.om_whatsapp_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.link(ref('group_trainer'))]"/>
    </record>
    <record id="om_whatsapp_base.om_whatsapp_menu_messages" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('om_whatsapp_base.group_om_whatsapp_user')])]"/>
    </record>
    <record id="om_whatsapp_base.om_whatsapp_menu_templates" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('om_whatsapp_base.group_om_whatsapp_user')])]"/>
    </record>
</odoo>
