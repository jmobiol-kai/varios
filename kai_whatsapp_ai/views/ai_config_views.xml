<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kai_whatsapp_ai_config_view_list" model="ir.ui.view">
        <field name="name">kai.whatsapp.ai.config.list</field>
        <field name="model">kai.whatsapp.ai.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="account_id"/>
                <field name="enabled"/>
                <field name="api_model"/>
            </list>
        </field>
    </record>

    <record id="kai_whatsapp_ai_config_view_form" model="ir.ui.view">
        <field name="name">kai.whatsapp.ai.config.form</field>
        <field name="model">kai.whatsapp.ai.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Shop assistant"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="enabled"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="account_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="api_base_url" placeholder="https://host.example/v1"/>
                            <field name="api_model" placeholder="model-name"/>
                            <field name="api_key" password="True" groups="kai_whatsapp_ai.group_manager"/>
                            <field name="api_timeout"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="FAQ" name="faq">
                            <field name="faq_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question"/>
                                    <field name="answer"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catalog" name="catalog">
                            <field name="catalog_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kai_whatsapp_ai_config_action" model="ir.actions.act_window">
        <field name="name">AI Provider</field>
        <field name="res_model">kai.whatsapp.ai.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
