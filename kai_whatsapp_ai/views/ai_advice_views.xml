<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kai_whatsapp_ai_spec_view_list" model="ir.ui.view">
        <field name="name">kai.whatsapp.ai.spec.list</field>
        <field name="model">kai.whatsapp.ai.spec</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="role"/>
                <field name="capacity"/>
                <field name="capacity_uom"/>
                <field name="material"/>
                <field name="mouth_mm"/>
                <field name="thread_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="kai_whatsapp_ai_spec_view_form" model="ir.ui.view">
        <field name="name">kai.whatsapp.ai.spec.form</field>
        <field name="model">kai.whatsapp.ai.spec</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="product_id"/>
                        <field name="role"/>
                        <field name="capacity"/>
                        <field name="capacity_uom"/>
                        <field name="material"/>
                        <field name="mouth_mm"/>
                        <field name="thread_type"/>
                        <field name="height_mm"/>
                        <field name="diameter_mm"/>
                        <field name="colour"/>
                        <field name="finish"/>
                        <field name="food_grade"/>
                        <field name="hot_fill"/>
                        <field name="pasteurization"/>
                        <field name="pack_name"/>
                        <field name="pack_units"/>
                        <field name="min_order_qty"/>
                    </group>
                    <field name="uses" placeholder="Only uses you want repeated, for example miel or cosmética."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="kai_whatsapp_ai_spec_action" model="ir.actions.act_window">
        <field name="name">Product sheets</field>
        <field name="res_model">kai.whatsapp.ai.spec</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="kai_whatsapp_ai_advisory_view_list" model="ir.ui.view">
        <field name="name">kai.whatsapp.ai.advisory.list</field>
        <field name="model">kai.whatsapp.ai.advisory</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="activity"/>
                <field name="product_id"/>
                <field name="note"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="kai_whatsapp_ai_advisory_action" model="ir.actions.act_window">
        <field name="name">Activity guide</field>
        <field name="res_model">kai.whatsapp.ai.advisory</field>
        <field name="view_mode">list</field>
    </record>

    <record id="kai_whatsapp_ai_fit_view_list" model="ir.ui.view">
        <field name="name">kai.whatsapp.ai.fit.list</field>
        <field name="model">kai.whatsapp.ai.fit</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="jar_product_id"/>
                <field name="closure_product_id"/>
                <field name="note"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="kai_whatsapp_ai_fit_action" model="ir.actions.act_window">
        <field name="name">Jar and closure fit</field>
        <field name="res_model">kai.whatsapp.ai.fit</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
