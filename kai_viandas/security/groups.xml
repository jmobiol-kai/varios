<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_corporate_employee" model="res.groups">
        <field name="name">Empleado corporativo de La Fija</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
    <record id="group_operator" model="res.groups">
        <field name="name">Admin La Fija operativo</field>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('base.group_partner_manager')),
            Command.link(ref('product.group_product_manager')),
            Command.link(ref('product.group_product_pricelist')),
            Command.link(ref('sales_team.group_sale_manager')),
            Command.link(ref('account.group_account_manager')),
            Command.link(ref('account.group_account_user')),
            Command.link(ref('website.group_website_designer')),
            Command.link(ref('mrp.group_mrp_user'))]"/>
    </record>
</odoo>
