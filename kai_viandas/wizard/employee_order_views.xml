<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_order_form" model="ir.ui.view">
        <field name="name">lafija.employee.order.form</field>
        <field name="model">lafija.employee.order</field>
        <field name="arch" type="xml">
            <form string="Crear pedidos de empleados" class="lf-employee-order-form">
                <sheet>
                    <div class="oe_title">
                        <h1>Crear pedidos de empleados</h1>
                    </div>
                    <p>Usalo cuando un empleado te pasa el pedido de la semana por WhatsApp y no quiere entrar al portal. Elegí la empresa, el empleado y los platos de cada día; postre y bebida son opcionales y solo se pueden pedir si hay plato. Si dejás un día sin plato, o quitás el renglón, una reserva ya cargada de ese día no se modifica. Podés agregar un renglón para un día publicado de la semana que no esté en la grilla.</p>
                    <group>
                        <group>
                            <field name="allowed_company_ids" invisible="1"/>
                            <field name="customer_company_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}"
                                   placeholder="Primero elegí la empresa cliente"/>
                            <field name="website_id" options="{'no_open': True}"/>
                            <field name="focus_date" invisible="1"/>
                        </group>
                        <group invisible="not employee_id and not week_start">
                            <div class="d-flex align-items-center gap-2 flex-wrap o_lf_week_nav">
                                <button name="action_previous_week" type="object" string="Semana anterior" class="btn-secondary" icon="fa-chevron-left"
                                        invisible="not employee_id or not week_start"/>
                                <field name="week_start" invisible="1"/>
                                <field name="week_label" nolabel="1" readonly="1"/>
                                <button name="action_next_week" type="object" string="Semana siguiente" class="btn-secondary" icon="fa-chevron-right"
                                        invisible="not employee_id or not week_start"/>
                            </div>
                        </group>
                    </group>
                    <field name="notice" nolabel="1" invisible="not notice"/>
                    <p invisible="not employee_id">Los días publicados de la semana se precargan. Podés agregar o quitar renglones; quitar uno no anula una reserva ya cargada. En un renglón nuevo, elegí el día y después el plato, el postre y la bebida. Al guardar se aplican las reservas y la grilla se actualiza con lo vigente.</p>
                    <field name="can_add_line" invisible="1"/>
                    <div class="lf-cannot-add-line" invisible="can_add_line"/>
                    <field name="line_ids" nolabel="1" class="lf-employee-order-lines" invisible="not employee_id">
                        <list editable="bottom" js_class="lf_employee_order_list" decoration-info="is_focus">
                            <control>
                                <create string="Agregar pedido"/>
                            </control>
                            <field name="date" column_invisible="1"/>
                            <field name="is_focus" column_invisible="1"/>
                            <field name="past" column_invisible="1"/>
                            <field name="reservation_id" column_invisible="1"/>
                            <field name="has_pending" column_invisible="1"/>
                            <field name="current_product_id" column_invisible="1"/>
                            <field name="current_dessert_id" column_invisible="1"/>
                            <field name="current_drink_id" column_invisible="1"/>
                            <field name="plate_option_ids" column_invisible="1"/>
                            <field name="dessert_option_ids" column_invisible="1"/>
                            <field name="drink_option_ids" column_invisible="1"/>
                            <field name="available_menu_ids" column_invisible="1"/>
                            <field name="date_label" column_invisible="1"/>
                            <field name="menu_id" string="Día" options="{'no_create': True, 'no_open': True}"
                                   context="{'lf_day_label': 1}" placeholder="Elegí el día"
                                   readonly="past" force_save="1"/>
                            <field name="product_id" options="{'no_create': True, 'no_open': True}"
                                   placeholder="Sin reserva este día" readonly="past or not menu_id"/>
                            <field name="dessert_id" options="{'no_create': True, 'no_open': True}"
                                   placeholder="Sin postre" readonly="past or not product_id"/>
                            <field name="drink_id" options="{'no_create': True, 'no_open': True}"
                                   placeholder="Sin bebida" readonly="past or not product_id"/>
                            <field name="current_label" readonly="1"/>
                            <field name="after_cut" string="Lista tomada" optional="show"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Guardar pedidos" class="btn-primary"
                            invisible="not employee_id or not line_ids"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="employee_order_action" model="ir.actions.act_window">
        <field name="name">Crear pedidos de empleados</field>
        <field name="res_model">lafija.employee.order</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="employee_order_form"/>
        <field name="context">{}</field>
    </record>
</odoo>
