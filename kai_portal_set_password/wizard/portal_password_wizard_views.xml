<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kai_portal_password_wizard_form" model="ir.ui.view">
        <field name="name">kai.portal.password.wizard.form</field>
        <field name="model">kai.portal.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Establecer contraseña de portal">
                <div class="alert alert-info" role="alert">
                    No se envía ningún correo al cliente. Comuníquele usuario y contraseña por otro medio.
                </div>
                <group>
                    <field name="partner_id"/>
                    <field name="user_status"/>
                    <field name="existing_user_id" invisible="not existing_user_id"/>
                    <field name="login" readonly="existing_user_id"/>
                    <field name="new_password" password="True"/>
                    <field name="confirm_password" password="True"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Establecer contraseña" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kai_portal_password_wizard" model="ir.actions.act_window">
        <field name="name">Establecer contraseña de portal</field>
        <field name="res_model">kai.portal.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
        <field name="groups_id" eval="[(4, ref('kai_portal_set_password.group_portal_set_password'))]"/>
    </record>

    <!-- Entrada del menú Acción: acción de servidor con secuencia alta para que quede al final -->
    <record id="action_server_kai_portal_password" model="ir.actions.server">
        <field name="name">Establecer contraseña de portal</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form,list</field>
        <field name="sequence">100</field>
        <field name="groups_id" eval="[(4, ref('kai_portal_set_password.group_portal_set_password'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['ir.actions.act_window']._for_xml_id('kai_portal_set_password.action_kai_portal_password_wizard')
action['context'] = {'active_model': 'res.partner', 'active_id': records[:1].id, 'active_ids': records.ids}</field>
    </record>
</odoo>
